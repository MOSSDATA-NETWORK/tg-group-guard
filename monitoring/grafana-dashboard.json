{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "核心指标",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "验证通过率（24h）",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(telegram_group_guard_bot_verification_total{result=\"verified\"}[24h])) / clamp_min(sum(increase(telegram_group_guard_bot_verification_total[24h])), 1)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "处理消息（24h）",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(telegram_group_guard_bot_messages_total[24h]))" }
      ]
    },
    {
      "type": "stat",
      "title": "广告拦截（24h）",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 10, "y": 1 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": null } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(telegram_group_guard_bot_messages_total{result=\"ad_flagged\"}[24h]))" }
      ]
    },
    {
      "type": "stat",
      "title": "LLM 调用进行中",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 15, "y": 1 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 6 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "telegram_group_guard_bot_llm_in_flight" }
      ]
    },
    {
      "type": "stat",
      "title": "评分 Redis 状态",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 6, "w": 5, "x": 19, "y": 1 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "正常", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "降级", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "telegram_group_guard_bot_score_redis_degraded" }
      ]
    },
    {
      "type": "timeseries",
      "title": "消息处理速率（按结果）",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "广告拦截" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "检测通过" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (rate(telegram_group_guard_bot_messages_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "消息处理构成（24h）",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 7 },
      "id": 8,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["value", "percent"] },
        "tooltip": { "mode": "single", "sort": "none" },
        "displayLabels": [ "percent" ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (increase(telegram_group_guard_bot_messages_total[24h]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "验证结果速率",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 7 },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "verified" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "expired" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (rate(telegram_group_guard_bot_verification_total[15m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "LLM 广告检测",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 10,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "LLM 延迟分位",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by(le, provider) (rate(telegram_group_guard_bot_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{provider}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le, provider) (rate(telegram_group_guard_bot_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{provider}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by(le, provider) (rate(telegram_group_guard_bot_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 {{provider}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM 判定速率（按提供方）",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 12, "y": 17 },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*true.*" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(provider, flagged) (rate(telegram_group_guard_bot_llm_outcome_total[5m]))",
          "legendFormat": "{{provider}} 广告={{flagged}}"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "LLM 并发占用",
      "datasource": { "type": "prometheus", "uid": "kk-prometheus" },
      "gridPos": { "h": 9, "w": 4, "x": 20, "y": 17 },
      "id": 13,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 8,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 4 },
              { "color": "red", "value": 7 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        { "refId": "A", "expr": "telegram_group_guard_bot_llm_in_flight" }
      ]
    }
  ],

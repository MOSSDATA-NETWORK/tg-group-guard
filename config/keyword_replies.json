{
  "cooldown_seconds": 60,
  "rules": [
    {
      "keywords": ["群规", "规则"],
      "match": "any",
      "reply": "📜 群规请查看置顶消息，入群请先完成验证。"
    },
    {
      "keywords": ["新人", "进群"],
      "match": "all",
      "case_sensitive": false,
      "reply": "👋 新成员请先点击验证按钮完成入群验证，验证通过后即可发言。"
    },
    {
      "pattern": "(?i)(怎么|如何)(加入|进群|验证)",
      "reply": "🔐 请在群内点击机器人发送的验证按钮，按提示完成验证。"
    }
  ]
}

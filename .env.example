# ===== 必填 =====
# Telegram bot token,从 @BotFather 获取
TELEGRAM_BOT_TOKEN=
# 机器人用户名(不带 @),用于生成 verify 深链
TELEGRAM_BOT_USERNAME=

# ===== Web 服务 =====
# 验证页面基址(必须外网可达),生成 /verify/{token} 链接
VERIFY_BASE_URL=http://localhost:8000
WEB_HOST=0.0.0.0
WEB_PORT=8000
# HTTPS 可选,SSL_CERT_FILE 与 SSL_KEY_FILE 需同时设置
SSL_CERT_FILE=
SSL_KEY_FILE=
SSL_CA_FILE=

# ===== 存储 =====
DATABASE_PATH=data/verifications.sqlite3
REDIS_URL=redis://localhost:6379/0
REDIS_SCORE_PREFIX=telegram_group_guard_bot:adscore

# ===== 入群验证 =====
# 验证 token 有效期(秒),默认 600
VERIFICATION_TIMEOUT_SECONDS=600
# 过期清理任务间隔(秒),默认 300
CLEANUP_INTERVAL_SECONDS=300
# 授权使用的群 ID 列表(逗号分隔),留空则不限制
ALLOWED_CHAT_IDS=

# ===== 消息生命周期 =====
# 提示消息自动删除延迟(秒),留空或 0 表示不删除
MESSAGE_TTL_SECONDS=

# ===== 广告守卫 =====
# 总开关
AI_ENABLED=true
AD_GUARD_ENABLED=false
# llm 提供方:ollama 或 openai(旧值 hunyuan 会自动归一化为 openai)
AD_GUARD_PROVIDER=ollama
# 广告判定置信度阈值（0-1）。
# 含义：模型判定“是广告”后，若 confidence 低于此值，则视为模型把握不足，强制放行；
# 提高 → 拦截更保守（漏判更多），降低 → 拦截更激进（误判可能更多）。
AD_GUARD_THRESHOLD=0.8
# 短消息跳过 LLM 检测：消息正文长度（字符数）低于该值时不送 LLM，节省配额；
# 0 表示全部送检。启发式规则命中不受此限制
AD_GUARD_MIN_LENGTH=0
# 命中广告后是否封禁(否则只踢)
AD_GUARD_BAN=false
# 有效发言跳过阈值（SQLite 永久）：通过广告检测 +1，>= 此值后永久免检
AD_GUARD_SCORE_SKIP_THRESHOLD=3
# 评分封禁阈值(<=此分则触发低分处理)
AD_GUARD_SCORE_BAN_THRESHOLD=-10
# 广告投票持续秒数
AD_VOTE_DURATION_SECONDS=30
# LLM 并发上限,防打爆本地 Ollama
AD_GUARD_LLM_CONCURRENCY=4
# 启发式规则文件,支持热重载
AD_GUARD_RULES_FILE=config/ad_guard_rules.json

# ===== Ollama(AD_GUARD_PROVIDER=ollama 时必填) =====
OLLAMA_ENDPOINT=
OLLAMA_MODEL=qwen3:0.6b
# 注意:实际 floor 是 30 秒
OLLAMA_TIMEOUT_SECONDS=30

# ===== OpenAI 兼容端点(AD_GUARD_PROVIDER=openai 时必填) =====
# 适用于任何 OpenAI 协议兼容的端点:Halo Cloud / 混元 / OneAPI / vLLM 等
# 注:旧名 HUNYUAN_* 仍向后兼容读取,推荐改用 OPENAI_*
OPENAI_ENDPOINT=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# 注意:实际 floor 是 30 秒
OPENAI_TIMEOUT_SECONDS=30

# ===== 警告系统 =====
# 触发自动封禁的本月警告次数(>=1)
WARN_LIMIT=3

# ===== 网络代理 =====
# 访问 Bot API 经 socks5/http 代理转发
TELEGRAM_PROXY=

# ===== 可观测性 =====
# Prometheus /metrics 端点(同时需要 pip install prometheus_client)
ENABLE_METRICS=false

# ===== Admin WebUI =====
# /admin 管理后台,使用 Telegram Login Widget 登录
ADMIN_WEB_ENABLED=true
# 登录会话有效期(秒),默认 8 小时
ADMIN_SESSION_TTL_SECONDS=28800
# 每用户最多并发 session 数(超出时挤掉最旧的)
ADMIN_MAX_SESSIONS_PER_USER=5
# 每 IP 每分钟最多请求数(主要保护登录回调和 unban API)
ADMIN_RATE_LIMIT_PER_MIN=60
# 是否在反代后面(true 时根据 X-Forwarded-Proto 决定 cookie secure 属性,
# 并信任 X-Forwarded-For 作为限流来源 IP)。仅在确有 Nginx/Caddy/CF 反代时设为 true;
# 直连部署必须为 false,否则攻击者可伪造 XFF 头绕过 /admin 的 IP 限流
ADMIN_BEHIND_PROXY=false
# Telegram Login Widget 签名有效窗口(秒),默认 300,官方上限 86400
ADMIN_AUTH_AGE_SECONDS=300

# ===== 关键词自动回复 =====
# 总开关:命中规则文件中的关键词/正则时自动回复(独立于广告守卫开关)
KEYWORD_REPLY_ENABLED=false
# 规则文件,支持热重载(改文件即生效,无需重启)
KEYWORD_REPLY_RULES_FILE=config/keyword_replies.json
# 同一群同一规则的默认冷却秒数;规则文件中的 cooldown_seconds 可覆盖此值
KEYWORD_REPLY_COOLDOWN_SECONDS=60

# ===== 关键词自动删除 =====
# 总开关:命中规则文件中的关键词/正则时自动删除该消息(独立于广告守卫和关键词回复开关)
KEYWORD_DELETION_ENABLED=false
# 规则文件,支持热重载(改文件即生效,无需重启)
KEYWORD_DELETION_RULES_FILE=config/keyword_deletions.json

# ===== 版本检查与自助更新 =====
# 定时与 GitHub Release 比对版本号,有新版本时在管理后台「系统设置」页提示
UPDATE_CHECK_ENABLED=true
# 检查间隔(秒),默认 6 小时,下限 300
UPDATE_CHECK_INTERVAL_SECONDS=21600
# 比对目标仓库(owner/repo),fork 后改成自己的仓库
GITHUB_REPO=MOSSDATA-NETWORK/tg-group-guard
# 可选:GitHub API 令牌,避免匿名限流(60 次/小时)
GITHUB_TOKEN=

# ===== 日志 =====
LOG_LEVEL=INFO
